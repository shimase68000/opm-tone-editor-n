//
// json_error.def
//    included in json.c
//

//
// json error message
//
#define MES_JSON_ERR_NO_JSONFILE             "設定ファイルが見つかりません。"
#define MES_JSON_ERR_NO_KEY_QUOTE            "キーの引用符が閉じていません。"
#define MES_JSON_ERR_NO_COLON                "コロンがありません。"
#define MES_JSON_ERR_NO_VALUE_QUOTE          "値の引用符が閉じていません。"
#define MES_JSON_ERR_STACK_OVERFLOW          "ネストの深さが制限を超えました。"
#define MES_JSON_ERR_MISSING_BRACES          "括弧が閉じていません。"
#define MES_JSON_ERR_STRING_VALUE_NOT_QUOTED "文字列値は引用符で囲む必要があります。"
#define MES_JSON_WRN_UNKNOWN_KEY             "未知のキーを無視しました。"
#define MES_JSON_ERR_OVER_HIERARCHY_DEPTH    "KEY階層の深さが制限を超えました。"

// JSON error disp switch
#define MESS   (1<<0)
#define LINE   (1<<1)
#define KEY    (1<<2)
#define VALUE  (1<<3)

// JSON error mode
enum JSON_ERROR_MODE {
	ERROR = 0,
	WARNING
};

typedef struct {
	int  mode;
	char *str;
	int  dispsw;
} JSON_ERROR;

//
// json error code
//
enum JSON_ERROR_CODE {
	JSON_ERR_NO_JSONFILE = 1,
	JSON_ERR_NO_KEY_QUOTE,
	JSON_ERR_NO_COLON,
	JSON_ERR_NO_VALUE_QUOTE,
	JSON_ERR_STACK_OVERFLOW,
	JSON_ERR_MISSING_BRACES,
	JSON_ERR_STRING_VALUE_NOT_QUOTED,
	JSON_WRN_UNKNOWN_KEY,
	JSON_ERR_OVER_HIERARCHY_DEPTH
};

// define json error
static const JSON_ERROR json_error[] = {
	{ERROR,   (const char*)0,                       0                  }, // index 0: dummy
	{ERROR,   MES_JSON_ERR_NO_JSONFILE,             MESS               },
	{ERROR,   MES_JSON_ERR_NO_KEY_QUOTE,            MESS|LINE|KEY      },
	{ERROR,   MES_JSON_ERR_NO_COLON,                MESS|LINE|KEY      },
	{ERROR,   MES_JSON_ERR_NO_VALUE_QUOTE,          MESS|LINE|KEY|VALUE},
	{ERROR,   MES_JSON_ERR_STACK_OVERFLOW,          MESS|LINE          },
	{ERROR,   MES_JSON_ERR_MISSING_BRACES,          MESS|LINE          },
	{ERROR,   MES_JSON_ERR_STRING_VALUE_NOT_QUOTED, MESS|LINE|KEY|VALUE},
	{WARNING, MES_JSON_WRN_UNKNOWN_KEY,             MESS|LINE|KEY      },
	{ERROR,   MES_JSON_ERR_OVER_HIERARCHY_DEPTH,    MESS|LINE|KEY|VALUE}
};

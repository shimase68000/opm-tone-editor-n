//
// json_hier.def
//    (included in json.c)
//

enum {
	JSON_TYPE_INT = 0,
	JSON_TYPE_STR
};

typedef struct {
	const char *key;
	uint   hierval;
} JSON_HIER_VALUE;

typedef struct {
	int   type;
	const char *key;
	uint  hierval;
	int   i_def;	    // default value
	const char *c_def;  // default string
	int   i_val;        // config value
	char  c_val[128];   // config string
	char  c_flag;       // quote flag
} JSON_HIER_KEYLIST;

// hier value
static const JSON_HIER_VALUE json_hier_value[] = {
	{JSON_KEY_SCALEKEY,    JSON_HIERVAL_SCALEKEY},
	{JSON_KEY_OPM_CHANNEL, JSON_HIERVAL_OPM_CHANNEL},
	{JSON_KEY_AUTO_SELECT, JSON_HIERVAL_AUTO_SELECT},
	{JSON_KEY_FILE_IO,     JSON_HIERVAL_FILE_IO}
};

